# ════════════════════════════════════════════════
# Zunor — Environment Variables
# ════════════════════════════════════════════════
# Скопіюй цей файл як .env та заповни своїми значеннями:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# ⚠️ Ніколи не комітьте .env у git — він у .gitignore.


# ─── База даних ─────────────────────────────────
# PostgreSQL connection string.
# Локально: postgresql://user:password@localhost:5432/zunor
# Продакшн: бери з Supabase / Neon / Railway dashboard.
# Vercel: рядок ПУЛУ Neon (хост із «-pooler»): копій функції багато, і
# кожна відкривала б свої зʼєднання з базою напряму.
DATABASE_URL=


# ─── Better-Auth (авторизація) ──────────────────
# Базовий URL застосунку. Без слешу в кінці.
# Dev:  http://localhost:5173
# Прод: https://zunor.org
BETTER_AUTH_URL=

# Секрет для підпису сесій. Згенеруй:
#   openssl rand -base64 32
# Або: https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET=


# ─── SMTP (відправка email) ─────────────────────
# Gmail як SMTP-провайдер. Для іншого сервісу — заміни хост.
#
# Для Gmail потрібен App Password (не звичайний пароль):
#   1. Увімкни 2FA у Google account
#   2. https://myaccount.google.com/apppasswords
#   3. Створи новий App Password, скопіюй сюди
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Від кого приходить лист (видно отримувачу):
SMTP_FROM=Zunor <noreply@zunor.org>


# ─── Cloudinary (зберігання зображень) ──────────
# Реєстрація: https://cloudinary.com/users/register/free
# Усі ключі — у Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ─── Pusher Channels (realtime) ─────────────────
# Реєстрація: https://dashboard.pusher.com/accounts/sign_up
# Створи Channels app, бери ключі з App Keys tab.
# Cluster обирай географічно ближчий: eu, ap1, mt1, us2, us3 і т.д.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# Публічні (доступні в браузері — це нормально):
# Мають збігатися з PUSHER_KEY та PUSHER_CLUSTER вище.
PUBLIC_PUSHER_KEY=
PUBLIC_PUSHER_CLUSTER=eu


# ─── Cron (внутрішні задачі) ────────────────────
# Будь-який довгий випадковий рядок. Використовується як Bearer token
# у GET /api/cron, щоб ніхто чужий не запускав крон.
# Згенеруй: openssl rand -hex 32
CRON_SECRET=

# ─── Upstash Redis (кеш перед базою) ────────────
# Необовʼязково на Hostinger: без цих змінних кеш вимкнений і все йде в базу.
# На Vercel — ОБОВʼЯЗКОВО: ліміти, код другого фактора адмінки й стан
# акаунта мусять бути спільними для всіх копій функції.
# console.upstash.com → Redis → створи базу в регіоні поруч із сервером
# (Frankfurt для Hostinger EU) → вкладка REST API → URL і TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─── Telegram-бот (сповіщення) ──────────────────
# Необовʼязково: без токена блоку Telegram у налаштуваннях немає, а
# сповіщення йдуть лише на сайт.
# Telegram → @BotFather → /newbot → скопіюй токен виду 123456:ABC-...
# Прод: бот сам ставить вебхук на BETTER_AUTH_URL/api/telegram/webhook.
# Dev: бот працює через polling, якщо в нього немає вебхука — тож для
# розробки заведи ОКРЕМОГО бота, інакше dev вимкне вебхук продового.
# Тестовий деплой (Vercel) — теж окремий бот або порожньо: інакше він
# перехопить вебхук бойового.
TELEGRAM_BOT_TOKEN=


# ─── Google OAuth (вхід через Google) ───────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client.
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Обовʼязкові навіть порожніми: вшиваються на збірці ($env/static/private).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── DeepSeek (AI-асистент заявок) ──────────────
# platform.deepseek.com → API keys. Вшивається на збірці.
DEEPSEEK_API_KEY=


# ═══ Лише для Vercel (docs/deploy-vercel.md) ═════
# На Hostinger (один Node-процес) нічого з цього не потрібно.

# ─── Upstash QStash (черга хвиль розсилки) ──────
# Обовʼязково на Vercel: таймер там не доживає до хвилі 2, тож хвилі 2–4
# ставить QStash. console.upstash.com → QStash → усе чотири значення.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Регіон функцій — поруч із базою Neon. За замовчуванням fra1 (Франкфурт).
# ZUNOR_VERCEL_REGION=fra1

# Лише ТЕСТОВИЙ деплой: пускати вхід із Expo Go (exp://), щоб ганяти
# мобільний застосунок проти нього. На бойовому — ніколи.
# ZUNOR_EXPO_GO=1
