generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  emailVerified        Boolean        @default(false)
  name                 String?
  username             String?        @unique
  phone                String?
  avatar               String?
  avatarPublicId       String?
  bio                  String?
  role                 Role           @default(CLIENT)
  city                 String?
  onboarded            Boolean        @default(false)
  avgRatingAsMaster    Float          @default(0)
  reviewsCountAsMaster Int            @default(0)
  avgRatingAsClient    Float          @default(0)
  reviewsCountAsClient Int            @default(0)
  isOnline             Boolean        @default(false)
  lastSeen             DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  banned               Boolean        @default(false)
  banReason            String?
  banExpires           DateTime?
  accounts             Account[]
  chats                ChatMember[]
  jobs                 Job[]          @relation("ClientJobs")
  masterProfile        MasterProfile?
  sentMessages         Message[]      @relation("SentMessages")
  notifications        Notification[]
  clientOrders         Order[]        @relation("ClientOrders")
  masterOrders         Order[]        @relation("MasterOrders")
  orderEvents          OrderEvent[]
  proposals            Proposal[]     @relation("MasterProposals")
  authoredReviews      Review[]       @relation("AuthorReviews")
  sessions             Session[]

  @@index([username])
  @@index([role, city])
}

model MasterProfile {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  categories               String[]           @default([])
  description              String?
  metadata                 Json?
  portfolioImages          String[]           @default([])
  portfolioImagesPublicIds String[]           @default([])
  verificationStatus       VerificationStatus @default(NONE)
  verificationRejectReason String?
  verifiedAt               DateTime?
  isActive                 Boolean            @default(true)
  completedOrders          Int                @default(0)
  totalOrders              Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@index([isActive])
}

model Job {
  id                   String     @id @default(cuid())
  clientId             String
  category             String
  city                 String
  title                String
  description          String?
  metadata             Json?
  budgetMinCents       Int?
  budgetMaxCents       Int?
  currency             String     @default("UAH")
  attachments          String[]   @default([])
  attachmentsPublicIds String[]   @default([])
  status               JobStatus  @default(OPEN)
  proposalsCount       Int        @default(0)
  viewsCount           Int        @default(0)
  expiresAt            DateTime
  closedAt             DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  selectedOrderId      String?    @unique
  client               User       @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)
  selectedOrder        Order?     @relation("JobToOrder", fields: [selectedOrderId], references: [id])
  proposals            Proposal[]

  @@index([status, createdAt])
  @@index([category, city, status])
  @@index([clientId])
  @@index([expiresAt])
}

model Proposal {
  id            String         @id @default(cuid())
  jobId         String
  masterId      String
  message       String
  priceCents    Int
  estimatedDays Int
  status        ProposalStatus @default(SENT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  withdrawnAt   DateTime?
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  master        User           @relation("MasterProposals", fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([jobId, masterId])
  @@index([jobId, status])
  @@index([masterId, status])
}

model Order {
  id            String       @id @default(cuid())
  clientId      String
  masterId      String
  title         String
  description   String
  metadata      Json?
  priceCents    Int
  currency      String       @default("UAH")
  status        OrderStatus  @default(CREATED)
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  chatId        String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  removedAt     DateTime?
  removedById   String?
  removedReason String?
  fromJob       Job?         @relation("JobToOrder")
  chat          Chat?        @relation(fields: [chatId], references: [id])
  client        User         @relation("ClientOrders", fields: [clientId], references: [id])
  master        User         @relation("MasterOrders", fields: [masterId], references: [id])
  events        OrderEvent[]
  reviews       Review[]

  @@index([clientId, status])
  @@index([masterId, status])
  @@index([status, createdAt])
  @@index([removedAt])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  actorId   String?
  payload   Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Chat {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastMessageText String?
  lastMessageAt   DateTime?
  lastSenderId    String?
  members         ChatMember[]
  messages        Message[]
  order           Order?

  @@index([lastMessageAt])
}

model ChatMember {
  id         String    @id @default(cuid())
  chatId     String
  userId     String
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id                 String      @id @default(cuid())
  type               MessageType @default(TEXT)
  text               String      @default("")
  attachmentUrl      String?
  attachmentPublicId String?
  attachmentMimeType String?
  attachmentSize     Int?
  attachmentName     String?
  isRead             Boolean     @default(false)
  editedAt           DateTime?
  deletedAt          DateTime?
  chatId             String
  senderId           String
  replyToId          String?
  createdAt          DateTime    @default(now())
  chat               Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  replyTo            Message?    @relation("MessageReply", fields: [replyToId], references: [id])
  replies            Message[]   @relation("MessageReply")
  sender             User        @relation("SentMessages", fields: [senderId], references: [id])

  @@index([chatId, createdAt])
}

model Review {
  id        String          @id @default(cuid())
  rating    Int
  comment   String?
  direction ReviewDirection
  orderId   String
  authorId  String
  createdAt DateTime        @default(now())
  author    User            @relation("AuthorReviews", fields: [authorId], references: [id])
  order     Order           @relation(fields: [orderId], references: [id])

  @@unique([orderId, direction])
  @@index([authorId])
}

model Category {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  icon           String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  metadataSchema Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model City {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  region    String?
  isCapital Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([region])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String?
  jobId      String?
  proposalId String?
  orderId    String?
  chatId     String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Session {
  id             String   @id
  userId         String
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model DispatchEvent {
  id          String    @id @default(cuid())
  jobId       String
  masterId    String
  wave        Int
  score       Float
  notifiedAt  DateTime  @default(now())
  openedAt    DateTime?
  respondedAt DateTime?
  declined    Boolean   @default(false)

  @@unique([jobId, masterId])
  @@index([jobId])
  @@index([masterId])
}

enum Role {
  CLIENT
  MASTER
  ADMIN
  MANAGER
  MODERATOR
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ProposalStatus {
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrderStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  PHOTO
  FILE
  SYSTEM
}

enum ReviewDirection {
  CLIENT_TO_MASTER
  MASTER_TO_CLIENT
}
